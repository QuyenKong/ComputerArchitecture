  <circuit name="MEM_WB">
    <a name="appearance" val="custom"/>
    <a name="circuit" val="MEM_WB"/>
    <a name="circuitnamedboxfixedsize" val="true"/>
    <a name="simulationFrequency" val="1.0"/>
    <appear>
      <rect fill="#fef9c3" height="270" stroke="#000000" stroke-width="2" width="70" x="50" y="50"/>
      <text dominant-baseline="central" font-family="SansSerif" font-size="11" font-weight="bold" text-anchor="middle" x="85" y="64">MEM/WB</text>
      <text dominant-baseline="central" font-family="SansSerif" font-size="9" text-anchor="middle" x="85" y="90">valid</text><text dominant-baseline="central" font-family="SansSerif" font-size="9" text-anchor="middle" x="85" y="110">pc</text><text dominant-baseline="central" font-family="SansSerif" font-size="9" text-anchor="middle" x="85" y="130">instr</text><text dominant-baseline="central" font-family="SansSerif" font-size="9" text-anchor="middle" x="85" y="150">exres</text><text dominant-baseline="central" font-family="SansSerif" font-size="9" text-anchor="middle" x="85" y="170">mdata</text><text dominant-baseline="central" font-family="SansSerif" font-size="9" text-anchor="middle" x="85" y="190">rd</text><text dominant-baseline="central" font-family="SansSerif" font-size="9" text-anchor="middle" x="85" y="210">RegWrite</text><text dominant-baseline="central" font-family="SansSerif" font-size="9" text-anchor="middle" x="85" y="230">MemToReg</text><text dominant-baseline="central" font-family="SansSerif" font-size="9" text-anchor="middle" x="85" y="250">Halt</text><text dominant-baseline="central" font-family="SansSerif" font-size="8" text-anchor="middle" x="60" y="310">clk</text><text dominant-baseline="central" font-family="SansSerif" font-size="8" text-anchor="middle" x="85" y="310">en</text><text dominant-baseline="central" font-family="SansSerif" font-size="8" text-anchor="middle" x="110" y="310">fl</text>
      <circ-port dir="in" pin="160,240" x="50" y="90"/>
