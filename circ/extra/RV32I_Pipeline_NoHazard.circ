    <comp lib="9" loc="(60,40)" name="Text">
      <a name="text" val="Pipeline register MEM/WB: luu toan bo thong tin cua 1 lenh giua 2 tang"/>
      <a name="font" val="SansSerif bold 12"/>
      <a name="color" val="#1e3a8a"/>
      <a name="halign" val="left"/>
      <a name="valign" val="base"/>
    </comp>
    <comp lib="9" loc="(60,56)" name="Text">
      <a name="text" val="EN = 0  -&gt; giu nguyen gia tri (stall).   FLUSH = 1 -&gt; nap 0 (bien lenh thanh bubble/NOP)"/>
      <a name="font" val="SansSerif plain 11"/>
      <a name="color" val="#1e3a8a"/>
      <a name="halign" val="left"/>
      <a name="valign" val="base"/>
    </comp>
    <comp lib="9" loc="(60,72)" name="Text">
      <a name="text" val="Moi gia tri 0 = an toan: valid=0, instr=0 (khong phai lenh hop le), moi tin hieu dieu khien = 0"/>
      <a name="font" val="SansSerif plain 11"/>
      <a name="color" val="#1e3a8a"/>
      <a name="halign" val="left"/>
      <a name="valign" val="base"/>
    </comp>
