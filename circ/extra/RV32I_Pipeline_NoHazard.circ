      <text dominant-baseline="central" font-family="SansSerif" font-size="13" font-weight="bold" text-anchor="middle" x="115" y="155">I/O Ctrl</text>
      <text dominant-baseline="central" font-family="SansSerif" font-size="9" font-style="italic" text-anchor="middle" x="115" y="169">UART + GPIO</text>
      <text dominant-baseline="central" font-family="SansSerif" font-size="8" text-anchor="start" x="54" y="70">Addr</text>
      <text dominant-baseline="central" font-family="SansSerif" font-size="8" text-anchor="start" x="54" y="90">WData</text>
      <text dominant-baseline="central" font-family="SansSerif" font-size="8" text-anchor="start" x="54" y="110">MemWrite</text>
      <text dominant-baseline="central" font-family="SansSerif" font-size="8" text-anchor="start" x="54" y="130">MemRead</text>
      <text dominant-baseline="central" font-family="SansSerif" font-size="8" text-anchor="start" x="54" y="150">IsIO</text>
      <text dominant-baseline="central" font-family="SansSerif" font-size="8" text-anchor="start" x="54" y="170">CLK</text>
      <text dominant-baseline="central" font-family="SansSerif" font-size="8" text-anchor="start" x="54" y="200">KbdData</text>
      <text dominant-baseline="central" font-family="SansSerif" font-size="8" text-anchor="start" x="54" y="220">KbdAvail</text>
      <text dominant-baseline="central" font-family="SansSerif" font-size="8" text-anchor="start" x="54" y="240">GpioIn</text>
      <text dominant-baseline="central" font-family="SansSerif" font-size="8" text-anchor="end" x="176" y="70">IoRData</text>
      <text dominant-baseline="central" font-family="SansSerif" font-size="8" text-anchor="end" x="176" y="110">TxWE</text>
      <text dominant-baseline="central" font-family="SansSerif" font-size="8" text-anchor="end" x="176" y="130">TxData</text>
      <text dominant-baseline="central" font-family="SansSerif" font-size="8" text-anchor="end" x="176" y="170">KbdRE</text>
