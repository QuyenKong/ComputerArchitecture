    <comp lib="9" loc="(60,40)" name="Text">
      <a name="text" val="I/O Controller (memory-mapped I/O): thiet bi ngoai vi chi la vai dia chi dac biet"/>
      <a name="font" val="SansSerif bold 12"/>
      <a name="color" val="#1e3a8a"/>
      <a name="halign" val="left"/>
      <a name="valign" val="base"/>
    </comp>
    <comp lib="9" loc="(60,56)" name="Text">
      <a name="text" val="Vung I/O: Addr[31:28] = 0xF.  Thanh ghi I/O chon bang Addr[4:2]:"/>
      <a name="font" val="SansSerif plain 11"/>
      <a name="color" val="#1e3a8a"/>
      <a name="halign" val="left"/>
      <a name="valign" val="base"/>
    </comp>
    <comp lib="9" loc="(60,72)" name="Text">
      <a name="text" val="0xF0000000 UART_TXDATA (W)   0xF0000004 UART_RXDATA (R)   0xF0000008 UART_STATUS (R)"/>
      <a name="font" val="SansSerif plain 11"/>
      <a name="color" val="#1e3a8a"/>
      <a name="halign" val="left"/>
      <a name="valign" val="base"/>
    </comp>
    <comp lib="9" loc="(60,88)" name="Text">
